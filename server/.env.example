# ─── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Auth (ADR-05: stateless JWT, short TTL + refresh rotation) ───────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Data Access (ADR-03: MongoDB) ────────────────────────────────────────
# Leave blank to auto-start an in-memory MongoDB (dev only, data resets).
# MongoDB Atlas M0 free tier:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/medintel?retryWrites=true&w=majority
MONGODB_URI=

# ─── Cache / Queue (in-memory driver unless REDIS_URL is set) ─────────────
REDIS_URL=

# ─── AI Service (ADR-04: provider behind an adapter) ──────────────────────
# Primary provider. Free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback provider slot. Free tier: https://aistudio.google.com/apikey
# Leave blank to keep Gemini dormant; setting it activates the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=30000

# ─── Reports OCR (free tier: https://ocr.space/ocrapi) ────────────────────
# Leave blank to queue reports as "Processing" without text extraction.
OCR_SPACE_API_KEY=
